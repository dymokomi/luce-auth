import auth

pub func main(arguments: str[]) -> i32!:
    discard(arguments)
    var invite = auth.Invite(flags = 0, expiry_unix = 1700000000, code = "invite-code", role = 2)
    for i in 0..<(usize)32: invite.nonce[i] = (u8)(i + 1)
    var encoded: u8[128]
    let n = try auth.encode_invite(invite, encoded)
    let decoded = try auth.decode_invite(encoded[..<n])
    assert(decoded.flags == 0 and decoded.expiry_unix == 1700000000)
    assert(decoded.code == "invite-code" and decoded.role == 2)
    for i in 0..<(usize)32: assert(decoded.nonce[i] == (u8)(i + 1))
    var failed = false
    encoded[4] = 2
    discard(auth.decode_invite(encoded[..<n]) catch failure:
        assert(failure.code == auth.invalid)
        failed = true
        recover invite)
    assert(failed)
    var salt: u8[16]
    var nonce: u8[24]
    for i in 0..<(usize)16: salt[i] = (u8)(i + 3)
    for i in 0..<(usize)24: nonce[i] = (u8)(i + 7)
    let plain = b"identity-seed"
    var ciphertext: u8[13]
    var tag: u8[16]
    var opened: u8[13]
    try auth.wrap_vault(b"password", salt, nonce, plain, ciphertext, tag)
    try auth.unwrap_vault(b"password", salt, nonce, ciphertext, tag, opened)
    for i in 0..<plain.length: assert(opened[i] == plain[i])
    failed = false
    tag[0] ^= 1
    auth.unwrap_vault(b"password", salt, nonce, ciphertext, tag, opened) catch failure:
        assert(failure.code == auth.forged)
        failed = true
        recover ()
    assert(failed)
    var digest: u8[32]
    assert(try auth.token_digest(b"secret-token", digest) == 32)
    assert(auth.production_memory_kib == 65536 and auth.production_passes == 3)
    print("PASS LID1 invite encode/decode and Argon2id XChaCha vault")
    return 0
