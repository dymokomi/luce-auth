## Password vault: Argon2id wrapping + XChaCha20-Poly1305. Uncalibrated costs.
import crypto_native

pub let invalid = crypto_native.invalid
pub let forged = crypto_native.forged
## Uncalibrated production starting point from CONTRACTS.md. Tests use smaller costs.
pub let production_memory_kib: u32 = 65536
pub let production_passes: u32 = 3
pub let production_lanes: u32 = 1

pub func wrap(password: const u8[], salt: const u8[], nonce: const u8[], plaintext: const u8[],
    ciphertext: u8[], tag: u8[], memory_kib: u32 = 8192, passes: u32 = 1, lanes: u32 = 1) -> !:
    if salt.length != 16 or nonce.length != 24: error(invalid, "vault salt is 16 bytes and nonce is 24")
    if ciphertext.length < plaintext.length or tag.length < 16: error(invalid, "vault output buffers are too small")
    var key: u8[32]
    defer crypto_native.wipe(key)
    let parameters = crypto_native.Argon2Parameters(memory_kib = memory_kib, passes = passes, lanes = lanes)
    try crypto_native.argon2id(password, salt, key, parameters)
    try crypto_native.aead_seal(key, nonce, b"LID1vault", plaintext, ciphertext, tag)

pub func unwrap(password: const u8[], salt: const u8[], nonce: const u8[], ciphertext: const u8[],
    tag: const u8[], plaintext: u8[], memory_kib: u32 = 8192, passes: u32 = 1, lanes: u32 = 1) -> !:
    if salt.length != 16 or nonce.length != 24: error(invalid, "vault salt is 16 bytes and nonce is 24")
    var key: u8[32]
    defer crypto_native.wipe(key)
    let parameters = crypto_native.Argon2Parameters(memory_kib = memory_kib, passes = passes, lanes = lanes)
    try crypto_native.argon2id(password, salt, key, parameters)
    try crypto_native.aead_open(key, nonce, b"LID1vault", ciphertext, tag, plaintext)
