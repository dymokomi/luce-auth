## Users, one-use invitations and session tokens on a Prism store.
import interop
import memory
import prism
import crypto_native
import luce_auth.password as passwords

pub let invalid = prism.invalid
pub let missing = prism.missing
pub let conflict = prism.conflict
pub let closed = prism.closed
pub let busy = passwords.busy

func hex_digit(n: u8) -> u8:
    if n < 10:
        return 48 + n
    return 87 + n

func hex_encode(bytes: const u8[], out: u8[]) -> usize:
    var i: usize = 0
    while i < bytes.length:
        out[i * 2] = hex_digit(bytes[i] >> 4)
        out[i * 2 + 1] = hex_digit(bytes[i] & 15)
        i += 1
    return bytes.length * 2

func valid_name(name: str) -> bool:
    if name.length == 0 or name.length > 32:
        return false
    for byte in name.bytes:
        let ok = (byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9') or byte == '_'
        if not ok:
            return false
    return true

func random_bytes(count: usize, out: u8[]) -> !:
    var secret = try crypto_native.random_secret(count)
    defer secret.close()
    let bytes = try secret.bytes()
    var i: usize = 0
    while i < count:
        out[i] = bytes[i]
        i += 1

func user_path(name: str, out: u8[]) -> usize!:
    let prefix = b"/users/"
    if prefix.length + name.length > out.length:
        error(invalid, "auth path is too long")
    var i: usize = 0
    while i < prefix.length:
        out[i] = prefix[i]
        i += 1
    var j: usize = 0
    while j < name.length:
        out[i] = name.bytes[j]
        i += 1
        j += 1
    return i

func join_prefix(prefix: const u8[], name: str, out: u8[]) -> usize!:
    if prefix.length + name.length > out.length:
        error(invalid, "auth path is too long")
    var i: usize = 0
    while i < prefix.length:
        out[i] = prefix[i]
        i += 1
    var j: usize = 0
    while j < name.length:
        out[i] = name.bytes[j]
        i += 1
        j += 1
    return i

pub struct Authority:
    var store: interop.Reference[prism.Store]
    var borrowed: prism.Store*?
    var owns: bool
    var alive: bool
    var test_only: bool

    pub func init():
        return

    pub static func open(path: str, token: str, test_only: bool = false) -> interop.Reference[Authority]!:
        if token.length == 0:
            error(invalid, "auth store token is required")
        let store = try prism.Store.open(path, token = token)
        let native = new Authority() in memory.heap catch failure:
            store.release()
            error(failure.code, failure.message)
        native.store = store
        native.borrowed = none
        native.owns = true
        native.alive = true
        native.test_only = test_only
        native.ensure_dirs() catch failure:
            native.close()
            free(native) in memory.heap
            error(failure.code, failure.message)
        # adopt consumes/disposes native even when its allocation fails.
        return try interop.Reference[Authority].adopt(native, authority_type, memory.heap)

    pub static func attach(store: prism.Store*, test_only: bool = false) -> interop.Reference[Authority]!:
        let native = try new Authority() in memory.heap
        native.borrowed = store
        native.owns = false
        native.alive = true
        native.test_only = test_only
        native.ensure_dirs() catch failure:
            native.close()
            free(native) in memory.heap
            error(failure.code, failure.message)
        return try interop.Reference[Authority].adopt(native, authority_type, memory.heap)

    func engine() -> prism.Store*!:
        if not self.alive:
            error(closed, "authority is closed")
        if self.owns:
            return self.store.value()
        return self.borrowed else error(closed, "authority is closed")

    func ensure_dirs() -> !:
        let store = try self.engine()
        let tx = try store.begin()
        defer tx.release()
        var changed = false
        for path in ["/users", "/invites", "/sessions"]:
            if not try tx.value().contains(path):
                try tx.value().add(path, "directory")
                changed = true
        if not changed: return
        discard(try tx.value().commit())
        discard(try store.bake())

    pub func bootstrap(name: str, password: str) -> !:
        if not valid_name(name) or password.length == 0:
            error(invalid, "invalid user or password")
        try self.put_user(name, password, first_user = true)

    pub func invite() -> interop.Reference[prism.Value]!:
        var raw: u8[16]
        try random_bytes(16, raw)
        var code: u8[32]
        discard(hex_encode(raw, code))
        let text = (str)code
        var path_buf: u8[48]
        let n = try join_prefix(b"/invites/", text, path_buf)
        let path = (str)path_buf[..<n]
        let store = try self.engine()
        let tx = try store.begin()
        defer tx.release()
        try tx.value().add(path, "file")
        let flag = try prism.Value.text("open")
        defer flag.release()
        try tx.value().set(path, "state", flag)
        discard(try tx.value().commit())
        discard(try store.bake())
        return try prism.Value.text(text)

    pub func accept(code: str, name: str, password: str) -> !:
        if code.length == 0 or not valid_name(name) or password.length == 0:
            error(invalid, "invalid invitation, user or password")
        var path_buf: u8[48]
        let n = try join_prefix(b"/invites/", code, path_buf)
        let invite = (str)path_buf[..<n]
        try self.put_user(name, password, invite)

    func put_user(name: str, password: str, invitation: str = "", first_user: bool = false) -> !:
        var path_buf: u8[48]
        let n = try user_path(name, path_buf)
        let path = (str)path_buf[..<n]
        var record: u8[64]
        defer crypto_native.wipe(record)
        try passwords.create(password.bytes, record, passwords.Profile.test_only if self.test_only else passwords.Profile.interactive)
        let store = try self.engine()
        let tx = try store.begin()
        defer tx.release()
        if first_user:
            let kids = try tx.value().children("/users")
            defer kids.release()
            if kids.value().count() != 0:
                error(conflict, "authority already has users")
            # Prism detects write overlap, not read predicates. Competing first
            # users must both write this same field to force a commit conflict.
            let marker = try prism.Value.text(name)
            defer marker.release()
            try tx.value().set("/users", "bootstrap_owner", marker)
        if try tx.value().contains(path):
            error(conflict, "user already exists")
        if invitation.length > 0:
            let state = tx.value().get(invitation, "state") catch failure:
                error(invalid, "invitation is not valid")
            defer state.release()
            if try state.value().text_at() != "open":
                error(invalid, "invitation is not valid")
            try tx.value().remove(invitation)
        try tx.value().add(path, "file")
        let verifier = try prism.Value.array(prism.DType.uint8, [64], record)
        defer verifier.release()
        try tx.value().set(path, "password_record", verifier)
        discard(try tx.value().commit(wait_ms = 1000))
        discard(try store.bake(wait_ms = 1000))

    pub func login(name: str, password: str) -> interop.Reference[prism.Value]!:
        if not valid_name(name) or password.length == 0 or password.length > 1024:
            error(invalid, "invalid user or password")
        var path_buf: u8[48]
        let n = try user_path(name, path_buf)
        let path = (str)path_buf[..<n]
        let store = try self.engine()
        let snap = try store.snapshot()
        defer snap.release()
        let verifier = snap.value().get(path, "password_record") catch failure:
            error(invalid, "invalid user or password")
        defer verifier.release()
        let accepted = passwords.verify(password.bytes, verifier.value().bytes(), allow_test = self.test_only) catch failure:
            if failure.code == busy: error(busy, "password hashing capacity exhausted")
            error(invalid, "invalid user or password")
        if not accepted:
            error(invalid, "invalid user or password")
        var raw: u8[16]
        try random_bytes(16, raw)
        var token: u8[32]
        discard(hex_encode(raw, token))
        let text = (str)token
        var session_path: u8[48]
        let sn = try join_prefix(b"/sessions/", text, session_path)
        let spath = (str)session_path[..<sn]
        let tx = try store.begin()
        defer tx.release()
        try tx.value().add(spath, "file")
        let who = try prism.Value.text(name)
        defer who.release()
        try tx.value().set(spath, "name", who)
        discard(try tx.value().commit())
        discard(try store.bake())
        return try prism.Value.text(text)

    pub func verify(token: str) -> interop.Reference[prism.Value]!:
        if token.length == 0:
            error(invalid, "session token is required")
        var session_path: u8[48]
        let n = try join_prefix(b"/sessions/", token, session_path)
        let path = (str)session_path[..<n]
        let store = try self.engine()
        let snap = try store.snapshot()
        defer snap.release()
        let who = try snap.value().get(path, "name")
        errdefer who.release()
        let name = try who.value().text_at()
        if not valid_name(name): error(invalid, "invalid session principal")
        var user_buffer: u8[48]
        let user_size = try user_path(name, user_buffer)
        let verifier = snap.value().get((str)user_buffer[..<user_size], "password_record") catch:
            error(invalid, "session password profile is unavailable")
        defer verifier.release()
        discard(passwords.profile_of(verifier.value().bytes(), allow_test = self.test_only) catch:
            error(invalid, "session password profile is disallowed"))
        return who

    pub func revoke(token: str) -> !:
        if token.length == 0:
            error(invalid, "session token is required")
        var session_path: u8[48]
        let n = try join_prefix(b"/sessions/", token, session_path)
        let path = (str)session_path[..<n]
        let store = try self.engine()
        let tx = try store.begin()
        defer tx.release()
        try tx.value().remove(path)
        discard(try tx.value().commit())
        discard(try store.bake())

    pub mutating func close():
        if not self.alive:
            return
        self.alive = false
        if self.owns:
            self.store.release()
        self.borrowed = none

pub let authority_type = interop.Type[Authority]("Prism authority", Authority.close, closeable = true)
