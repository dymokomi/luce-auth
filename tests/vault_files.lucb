import credential_files as vault
import crypto_native as crypto

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 3)
    let plaintext = b"disposable registry credentials"
    if arguments[1] == "create":
        var published = false
        try vault.create(arguments[2], b"fixture password", plaintext, &published)
        assert(published)
    else:
        var secret = try vault.open(arguments[2], b"wrong password" if arguments[1] == "wrong" else b"fixture password")
        defer secret.close()
        assert(crypto.equal(try secret.bytes(), plaintext))
    print("PASS private vault file")
    return 0
