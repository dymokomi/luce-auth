import password_records as password
import crypto_native

pub func main(arguments: str[]) -> i32!:
    var record: u8[64]
    try password.create(b"fixture password", record, password.Profile.test_only)
    assert(try password.verify(b"fixture password", record, true))
    assert(not try password.verify(b"wrong password", record, true))
    var failed = false
    discard(password.verify(b"fixture password", record) catch:
        failed = true
        recover false)
    assert(failed)
    var another: u8[64]
    try password.create(b"fixture password", another, password.Profile.test_only)
    assert(not crypto_native.equal(record, another))
    for i in 0..<(usize)16:
        record[i] ^= 128
        failed = false
        discard(password.profile_of(record, true) catch:
            failed = true
            recover password.Profile.interactive)
        assert(failed)
        record[i] ^= 128
    for n in 0..<record.length:
        failed = false
        discard(password.profile_of(record[..<n], true) catch:
            failed = true
            recover password.Profile.interactive)
        assert(failed)
    for i in 0..<record.length: record[i] = 173
    failed = false
    password.create(b"", record) catch:
        failed = true
    assert(failed)
    for byte in record: assert(byte == 173)
    if arguments.length == 2 and arguments[1] == "production":
        try password.create(b"fixture password", record)
        assert(try password.profile_of(record) == password.Profile.interactive)
        assert(try password.verify(b"fixture password", record))
        assert(not try password.verify(b"wrong password", record))
    print("PASS versioned password records, explicit test opt-in, bounds and atomic failure")
    return 0
