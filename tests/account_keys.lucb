import account_identity as keys
import crypto_native as crypto

pub func main(arguments: str[]) -> i32!:
    discard(arguments)
    var seed = try keys.generate()
    defer seed.close()
    var pk: u8[1952]
    try keys.public_key(try seed.bytes(), pk)
    var repeated: u8[1952]
    try keys.public_key(try seed.bytes(), repeated)
    assert(crypto.equal(pk, repeated))
    var challenge: u8[32]
    for i in 0..<challenge.length: challenge[i] = (u8)i
    var signature: u8[3309]
    try keys.prove(try seed.bytes(), "https://pkg.luciaos.com", "alice", challenge, signature)
    assert(try keys.verify(pk, "https://pkg.luciaos.com", "alice", challenge, signature))
    assert(not try keys.verify(pk, "https://other.example", "alice", challenge, signature))
    assert(not try keys.verify(pk, "https://pkg.luciaos.com", "bob", challenge, signature))
    challenge[0] ^= 1
    assert(not try keys.verify(pk, "https://pkg.luciaos.com", "alice", challenge, signature))
    challenge[0] ^= 1
    signature[100] ^= 1
    assert(not try keys.verify(pk, "https://pkg.luciaos.com", "alice", challenge, signature))
    signature[100] ^= 1
    pk[0] ^= 1
    assert(not try keys.verify(pk, "https://pkg.luciaos.com", "alice", challenge, signature))
    pk[0] ^= 1
    var second: u8[3309]
    try keys.prove(try seed.bytes(), "https://pkg.luciaos.com", "alice", challenge, second)
    assert(not crypto.equal(signature, second))
    for i in 0..<second.length: second[i] = 173
    var failed = false
    keys.prove(try seed.bytes(), "bad origin", "alice", challenge, second) catch:
        failed = true
    assert(failed)
    for byte in second: assert(byte == 173)
    for n in [(usize)0, (usize)31]:
        failed = false
        keys.prove((try seed.bytes())[..<n], "registry", "alice", challenge, second) catch:
            failed = true
        assert(failed)
        for byte in second: assert(byte == 173)
    failed = false
    keys.prove(try seed.bytes(), "registry", "alice", challenge[..<31], second) catch:
        failed = true
    assert(failed)
    for byte in second: assert(byte == 173)
    var largest_origin: u8[256]
    var largest_name: u8[33]
    for i in 0..<largest_origin.length: largest_origin[i] = 'a'
    for i in 0..<largest_name.length: largest_name[i] = 'a'
    try keys.prove(try seed.bytes(), (str)largest_origin[..<255], (str)largest_name[..<32], challenge, second)
    assert(try keys.verify(pk, (str)largest_origin[..<255], (str)largest_name[..<32], challenge, second))
    failed = false
    discard(keys.verify(pk, (str)largest_origin, "alice", challenge, signature) catch:
        failed = true
        recover false)
    assert(failed)
    failed = false
    discard(keys.verify(pk, "registry", (str)largest_name, challenge, signature) catch:
        failed = true
        recover false)
    assert(failed)
    # A raw signature on the challenge is not a domain-separated account proof.
    var sk: u8[4032]
    defer crypto.wipe(sk)
    try crypto.mldsa_keygen(try seed.bytes(), repeated, sk)
    var random: u8[32]
    try crypto.mldsa_sign(sk, challenge, random, second)
    assert(not try keys.verify(pk, "https://pkg.luciaos.com", "alice", challenge, second))
    print("PASS account ML-DSA possession, origin/account/challenge binding, domain separation and atomic failure")
    return 0
