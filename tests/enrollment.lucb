import auth
import account_identity as keys
import prism
import crypto_native as crypto
import thread

var worker_authority: auth.Authority*?
var worker_token: str
var public_key: u8[1952]
var signature: u8[3309]
var ready: @u32
var start: @u32
var success: @u32
var rejected: @u32

func enroll(raw: void*?):
    discard(raw)
    discard(ready.add(1, .release))
    while start.load(.acquire) == 0: thread.sleep(1)
    let authority = worker_authority else trap("missing authority")
    authority.enroll_key(worker_token, "https://pkg.luciaos.com", public_key, signature) catch failure:
        assert(failure.code == auth.conflict)
        discard(rejected.add(1, .relaxed))
        return
    discard(success.add(1, .relaxed))

func setup(path: str) -> !:
    let store = try prism.Store.open(path, token = "enrollment-fixture")
    defer store.release()
    let authority = try auth.Authority.attach(store.value(), test_only = true)
    defer authority.release()
    try authority.value().bootstrap("alice", "fixture")
    let session = try authority.value().login("alice", "fixture")
    defer session.release()
    let token = try session.value().text_at()
    assert(try authority.value().signing_key(token) == none)
    let old = try authority.value().key_challenge(token, "https://pkg.luciaos.com")
    defer old.release()
    var seed: u8[32]
    try keys.public_key(seed, public_key)
    try keys.prove(seed, "https://pkg.luciaos.com", "alice", old.value().bytes(), signature)
    let before = try store.value().snapshot()
    defer before.release()
    let revision = try before.value().revision()
    signature[0] ^= 1
    var failed = false
    authority.value().enroll_key(token, "https://pkg.luciaos.com", public_key, signature) catch:
        failed = true
    assert(failed)
    signature[0] ^= 1
    let after = try store.value().snapshot()
    defer after.release()
    assert(try after.value().revision() == revision)
    let tx = try store.value().begin()
    defer tx.release()
    let expired = try prism.Value.integer(1)
    defer expired.release()
    try tx.value().set("/users/alice", "key_issued", expired)
    discard(try tx.value().commit())
    failed = false
    authority.value().enroll_key(token, "https://pkg.luciaos.com", public_key, signature) catch failure:
        assert(failure.code == auth.invalid)
        failed = true
    assert(failed)
    let current = try authority.value().key_challenge(token, "https://pkg.luciaos.com")
    defer current.release()
    assert(not crypto.equal(old.value().bytes(), current.value().bytes()))
    failed = false
    authority.value().enroll_key(token, "https://pkg.luciaos.com", public_key, signature) catch:
        failed = true
    assert(failed)
    try keys.prove(seed, "https://pkg.luciaos.com", "alice", current.value().bytes(), signature)
    worker_authority = authority.value()
    worker_token = token
    var first = try thread.spawn(enroll, none)
    var second = thread.spawn(enroll, none) catch failure:
        start.store(1, .release)
        try first.join()
        error(failure.code, failure.message)
    while ready.load(.acquire) != 2: thread.sleep(1)
    start.store(1, .release)
    try first.join()
    try second.join()
    assert(success.load(.acquire) == 1 and rejected.load(.acquire) == 1)
    let enrolled = (try authority.value().signing_key(token)) else trap("missing enrolled key")
    defer enrolled.release()
    assert(crypto.equal(enrolled.value().bytes(), public_key))
    let invite = try authority.value().invite()
    defer invite.release()
    try authority.value().accept(try invite.value().text_at(), "bob", "fixture")
    let other = try authority.value().login("bob", "fixture")
    defer other.release()
    assert(try authority.value().signing_key(try other.value().text_at()) == none)
    failed = false
    authority.value().enroll_key(token, "https://pkg.luciaos.com", public_key, signature) catch failure:
        assert(failure.code == auth.conflict)
        failed = true
    assert(failed)
    try authority.value().revoke(token)
    failed = false
    let denied = authority.value().signing_key(token) catch:
        failed = true
        recover none
    if let value = denied: value.release()
    assert(failed)
    failed = false
    let unused = authority.value().key_challenge(token, "https://pkg.luciaos.com") catch:
        failed = true
        recover try prism.Value.text("denied")
    defer unused.release()
    assert(failed)

pub func main(arguments: str[]) -> i32!:
    assert(arguments.length == 2)
    try setup(arguments[1])
    let store = try prism.Store.open(arguments[1], token = "enrollment-fixture")
    defer store.release()
    let authority = try auth.Authority.attach(store.value(), test_only = true)
    defer authority.release()
    let session = try authority.value().login("alice", "fixture")
    defer session.release()
    let token = try session.value().text_at()
    let restored = (try authority.value().signing_key(token)) else trap("missing persisted key")
    defer restored.release()
    assert(crypto.equal(restored.value().bytes(), public_key))
    let snapshot = try store.value().snapshot()
    defer snapshot.release()
    let key = try snapshot.value().get("/users/alice", "signing_key")
    defer key.release()
    assert(crypto.equal(key.value().bytes(), public_key))
    let used = try snapshot.value().get("/users/alice", "key_used")
    defer used.release()
    assert(try used.value().integer_at() == 1)
    # Malformed stored data must fail closed, not report an unbound account.
    let tx = try store.value().begin()
    defer tx.release()
    let malformed = try prism.Value.text("not a key")
    defer malformed.release()
    try tx.value().set("/users/alice", "signing_key", malformed)
    discard(try tx.value().commit())
    var failed = false
    let corrupt = authority.value().signing_key(token) catch:
        failed = true
        recover none
    if let value = corrupt: value.release()
    assert(failed)
    assert(crypto.equal(restored.value().bytes(), public_key))
    print("PASS atomic key enrollment, failed-proof no-write, expiry, replacement, concurrent consume and reopen")
    return 0
